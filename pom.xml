<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hjosugi</groupId>
    <artifactId>spring-chat-sample-simple</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>spring-chat-sample-simple</name>
    <description>The smallest application that uses spring-chat</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.1.0</spring-ai.version>
        <!-- Not on Maven Central yet: ./mvnw install in a clone of hjosugi/spring-chat at v0.1.0. -->
        <spring-chat.version>0.1.0</spring-chat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The chat: a page, the endpoints that stream a reply to it, and a conversation's memory. -->
        <dependency>
            <groupId>io.github.hjosugi</groupId>
            <artifactId>spring-chat-spring-boot-starter</artifactId>
            <version>${spring-chat.version}</version>
        </dependency>
        <!-- A web stack, and a model. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
